# Public HTTPS location produced by deploying ../html5-games/royal-feast/dist
EXPO_PUBLIC_ROYAL_FEAST_URL=https://html5-games-seven.vercel.app/

# Google Cloud OAuth client IDs used by native Google Sign-In.
# The Web client ID is required so Supabase can verify Google's ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-example.apps.googleusercontent.com
